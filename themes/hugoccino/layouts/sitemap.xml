{{- /* Sivukartan hakemisto: osat tiedostoissa sitemap-<osa>.xml (tyhjät osat jätetään pois) */ -}}
{{- $groups := partialCached "sitemap-groups.html" "x" -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<sitemapindex xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{{- range $k := slice "sivut" "artikkelit" "reseptit" "avainsanat" "kategoriat" "sarjat" "reseptiluokat" }}
  {{- $pages := index $groups $k }}
  {{- if $pages }}
  {{- $file := cond (eq $k "reseptiluokat") "reseptiluokat" $k }}
  <sitemap>
    <loc>{{ printf "sitemap-%s.xml" $file | absURL }}</loc>
    {{- with index ($pages.ByLastmod.Reverse) 0 }}{{ if not .Lastmod.IsZero }}
    <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</lastmod>
    {{- end }}{{ end }}
  </sitemap>
  {{- end }}
{{- end }}
</sitemapindex>
