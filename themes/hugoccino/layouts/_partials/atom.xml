{{- /*
  Atom-syöte vanhaa osoitetta /feed varten, samassa muodossa kuin vanhassa Laravel-blogissa: tiivistelmä ja koko sisältö (html).
  Merkinnän tunniste on vanhan blogin artikkelitunniste (data/legacy_ids.json), jotta lukijat eivät näytä vanhoja kirjoituksia uusina.
  Reseptit ja muut ilman vanhaa tunnistetta saavat tunnisteeksi osoitteensa. Dict: "page" "items".
*/ -}}
{{- $items := first 20 .items -}}
{{- $self := "feed" | absURL -}}
{{- $author := site.Params.author | default "Marko Kaartinen" -}}
{{ printf "<?xml version=\"1.0\" encoding=\"UTF-8\"?>" | safeHTML }}
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="fi-FI">
  <id>{{ $self }}</id>
  <link href="{{ $self }}" rel="self"></link>
  <title>{{ site.Title }}</title>
  <subtitle>{{ site.Params.description }}</subtitle>
  {{- with index $items 0 }}
  <updated>{{ (cond .Lastmod.IsZero .Date .Lastmod).Format "2006-01-02T15:04:05Z07:00" }}</updated>
  {{- end }}
  {{- range $items }}
  {{- $key := strings.TrimSuffix "/" .File.Dir }}
  {{- $legacy := index site.Data.legacy_ids $key }}
  {{- $id := cond (ne $legacy nil) (printf "%s/%d" (strings.TrimSuffix "/" site.BaseURL) (int $legacy)) .Permalink }}
  <entry>
    <title>{{ .Title }}</title>
    <link rel="alternate" href="{{ .Permalink }}" />
    <id>{{ $id }}</id>
    <author>
      <name>{{ $author }}</name>
    </author>
    <summary type="html">{{ .Description | default .Summary | plainify | htmlEscape | safeHTML }}</summary>
    <content type="html">{{ partial "feed-content.html" . | htmlEscape | safeHTML }}</content>
    <published>{{ .Date.Format "2006-01-02T15:04:05Z07:00" }}</published>
    <updated>{{ (cond .Lastmod.IsZero .Date .Lastmod).Format "2006-01-02T15:04:05Z07:00" }}</updated>
    {{- range .GetTerms (cond (eq .Type "resepti") "recipe_categories" "categories") }}
    <category term="{{ path.Base .RelPermalink }}" label="{{ .LinkTitle }}" />
    {{- end }}
  </entry>
  {{- end }}
</feed>
